<resources>
    <!-- Window theme of the Compose host activity. The UI theme is SwayConnectTheme in Kotlin.
         Light here and dark in values-night, so the starting window has the tone of the UI that follows.
         The window background is the theme's background token (docs/UX.md 3.1), so no flash before the first frame. -->
    <style name="Theme.SwayConnect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFEDEAE4</item>
    </style>
</resources>
