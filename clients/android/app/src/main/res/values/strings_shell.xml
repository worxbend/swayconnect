    <!-- Locked sheet scope sentences (UX 10.5); the rest of the sheet is in strings_common.xml -->
    <string name="scope_control">Lets the phone switch workspaces, move, float or fullscreen windows, and lock the computer.</string>
    <string name="scope_audio">Lets the phone change the volume and the output device, and mute the microphone.</string>
    <string name="scope_audio_capture">Lets the phone turn the microphone on, change its level and pick the input device. Someone with this phone could listen to the room.</string>
    <string name="scope_media">Lets the phone play, pause and skip media.</string>
    <string name="scope_idle_inhibit">Lets the phone stop the computer from locking itself when idle, for a limited time.</string>
    <string name="scope_launch">Lets the phone start apps and open the launcher. Terminals and apps marked risky need a second permission.</string>
    <string name="scope_launch_risky">Lets the phone start terminals and apps marked risky. That is the same as running commands.</string>
    <string name="scope_input">Lets the phone type into the focused window. In a terminal that is the same as running commands.</string>
    <string name="scope_destructive">Lets the phone close windows. Unsaved work can be lost.</string>
    <string name="scope_other">The owner of the computer can grant it by name.</string>

