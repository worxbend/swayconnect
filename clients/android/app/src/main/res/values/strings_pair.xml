    <string name="pair_scope_idle_inhibit">Keep awake</string>
    <string name="pair_scope_audio">Volume</string>
    <string name="pair_scope_audio_capture">Microphone</string>
    <string name="pair_scope_media">Media</string>
    <string name="pair_scope_launch">Start apps</string>
    <string name="pair_scope_launch_risky">Start terminals</string>
    <string name="pair_scope_input_text">Type text</string>
    <string name="pair_scope_input_keys">Send keys</string>
